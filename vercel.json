{
  "buildCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = qa/bhs-reserved-est ]; then export OFFER_BHS_QA_CASE=est OFFER_BHS_QA_COMMIT=\"$VERCEL_GIT_COMMIT_SHA\" OFFER_BHS_COLLECTION_FIRST=1 OFFER_BHS_QA_SEED_SNAPSHOT=est-reserve; fi; npm run build",
  "outputDirectory": "offer-engine/public",
  "functions": {
    "api/logo-upload.js": {
      "maxDuration": 300
    },
    "api/pricing.js": {
      "maxDuration": 60
    },
    "api/audit.js": {
      "maxDuration": 300,
      "includeFiles": "{offer-engine/src/bhs/**,node_modules/unpdf/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/logo.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/proposal.js": {
      "maxDuration": 300
    },
    "api/offer.js": {
      "maxDuration": 60
    },
    "api/preview-session.js": {
      "maxDuration": 60
    },
    "api/travis-run.js": {
      "maxDuration": 300
    },
    "api/offer-reuse.js": {
      "maxDuration": 300,
      "includeFiles": "offer-engine/src/bhs/**"
    },
    "api/bhs-worker.js": {
      "maxDuration": 300,
      "includeFiles": "{offer-engine/src/bhs/**,node_modules/unpdf/**,node_modules/@sparticuz/chromium/bin/**}",
      "regions": [
        "iad1"
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9-]+-teklifi)",
      "destination": "/offers/customer.html"
    },
    {
      "source": "/:slug([a-z0-9-]+-teklifi-v[0-9]+-[a-f0-9]+)",
      "destination": "/offers/customer.html"
    }
  ],
  "installCommand": "npm ci"
}
