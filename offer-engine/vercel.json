{
  "buildCommand": "npm run build && node scripts/research-probe.mjs --resume v1_Chc2eGZXYXByLUVlR0Uxc2dQdC1HSGlRdxIXNnhmV2Fwci1FZUdFMXNnUHQtR0hpUXc",
  "outputDirectory": "public",
  "functions": {
    "api/audit.js": {
      "maxDuration": 90,
      "includeFiles": "{src/bhs/**,node_modules/unpdf/**}"
    },
    "api/logo.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
