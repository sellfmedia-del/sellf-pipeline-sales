{
  "buildCommand": "node build.mjs && node scripts/proposal-validation.mjs --reuse=v1_ChZOWXJXYXJHeEF0NlJ5dE1QNWRDbldBEhZOWXJXYXJHeEF0NlJ5dE1QNWRDbldB",
  "outputDirectory": "public",
  "functions": {
    "api/pricing.js": {
      "maxDuration": 60
    },
    "api/audit.js": {
      "maxDuration": 180,
      "includeFiles": "{src/bhs/**,node_modules/unpdf/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/logo.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/proposal.js": {
      "maxDuration": 60
    },
    "api/offer.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
