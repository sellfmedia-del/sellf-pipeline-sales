{
  "buildCommand": "npm run build && node scripts/pricing-validation.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/pricing.js": {
      "maxDuration": 60
    },
    "api/audit.js": {
      "maxDuration": 180,
      "includeFiles": "{src/bhs/**,node_modules/unpdf/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/logo.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
