{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/logo.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }]
}
