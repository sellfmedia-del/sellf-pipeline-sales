{
  "buildCommand": "npm test && npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/iletisim",
      "destination": "/contact.html"
    },
    {
      "source": "/teklifinizi-arayin",
      "destination": "/search.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/en/find-your-proposal",
      "destination": "/en/search.html"
    },
    {
      "source": "/:slug([a-z0-9-]+-teklifi)",
      "destination": "https://sales.sellfmedia.com/offers/customer.html"
    },
    {
      "source": "/:slug([a-z0-9-]+-teklifi-v[0-9]+-[a-f0-9]+)",
      "destination": "https://sales.sellfmedia.com/offers/customer.html"
    },
    {
      "source": "/offers/customer.html",
      "destination": "https://sales.sellfmedia.com/offers/customer.html"
    },
    {
      "source": "/offers/customer.js",
      "destination": "https://sales.sellfmedia.com/offers/customer.js"
    },
    {
      "source": "/offers/proposal.js",
      "destination": "https://sales.sellfmedia.com/offers/proposal.js"
    },
    {
      "source": "/offers/proposal.css",
      "destination": "https://sales.sellfmedia.com/offers/proposal.css"
    }
  ],
  "functions": {
    "api/offer.js": {
      "maxDuration": 60
    }
  }
}
